# ===================================================
# AGRISIGHT: LARGE DATA FILES — DO NOT COMMIT
# ===================================================

# Raw datasets (7 GB+) — download with download_datasets.py
plantdoc_reorganized/

# Regenerable split CSVs — rebuild with prepare_data.py
data/pv_splits.csv
data/pd_test.csv

# Local dataset paths (machine-specific)
dataset_paths.txt

# Kaggle download cache
.cache/
kagglehub/

# ===================================================
# AGRISIGHT: OUTPUTS — KEEP TRAINED CHECKPOINTS
# ===================================================

# Keep final checkpoints (all < 20 MB, well under GitHub 100 MB limit)
# outputs/*.pt files are KEPT — do NOT add outputs/*.pt to .gitignore

# Exclude only the placeholder demo checkpoint (untrained, misleading)
outputs/demo_untrained.pt

# Keep .gitkeep placeholder to preserve the outputs/ folder in git
!outputs/.gitkeep

# ===================================================
# AGRISIGHT: RESULTS — KEEP ALL
# ===================================================

# results/ is kept in full (JSON, PNG, failure directories, summary.md)
# Nothing in results/ is gitignored

# ===================================================
# TEMPORARY / GENERATED FILES
# ===================================================

*.tmp
*.log

# PowerShell scripts (internal workflow helpers, not needed by users)
safe_git_push.ps1
run_demo.ps1
PUSH_RESULTS.txt
